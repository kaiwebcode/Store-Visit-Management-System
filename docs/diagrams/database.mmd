erDiagram
    USER ||--o{ STORE : assigned_to
    USER ||--o{ TASK : owns
    STORE ||--o{ TASK : contains
    TASK ||--o{ PHOTO_EVIDENCE : attaches
    TASK ||--o{ SYNC_QUEUE : enqueues

    USER {
        string user_id PK
        string username
        string full_name
        string auth_token
        string expires_at
    }

    STORE {
        string store_id PK
        string store_code
        string name
        string address
        string category
        string assigned_user_id FK
        string last_visited_at
        boolean is_active
    }

    TASK {
        string task_id PK
        string store_id FK
        string user_id FK
        string title
        string description
        string category
        string priority
        string status
        string due_date
        string created_at
        string updated_at
        string sync_status
        string sync_error
        boolean is_deleted
    }

    PHOTO_EVIDENCE {
        string photo_id PK
        string task_id FK
        string user_id FK
        string local_file_path
        string remote_url
        int file_size_bytes
        string mime_type
        string upload_status
        string created_at
    }

    SYNC_QUEUE {
        string operation_id PK
        string entity_type
        string entity_id
        string operation_type
        string user_id FK
        string payload_json
        int retry_count
        string status
        string error_message
        string created_at
    }
