<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sv_bg"
    android:orientation="vertical">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sv_appbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/sv_text" />

        <TextView
            android:id="@+id/tvScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Create Store Task"
            android:textColor="@color/sv_text"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollForm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Task Title Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Task Title *"
                android:textColor="@color/sv_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/sv_card_background"
                android:hint="Enter task title (e.g., Audit Entrance Display)"
                android:inputType="textCapSentences"
                android:padding="12dp"
                android:textColor="@color/sv_text"
                android:textColorHint="@color/sv_muted"
                android:textSize="15sp" />

            <!-- Task Description Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Description"
                android:textColor="@color/sv_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/sv_card_background"
                android:gravity="top|start"
                android:hint="Enter detailed task instructions or description..."
                android:inputType="textMultiLine"
                android:minLines="3"
                android:padding="12dp"
                android:textColor="@color/sv_text"
                android:textColorHint="@color/sv_muted"
                android:textSize="15sp" />

            <!-- Category Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Category"
                android:textColor="@color/sv_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:checkedChip="@id/chipCatGeneral"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatGeneral"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="GENERAL"
                    android:textColor="@color/sv_text"
                    app:chipBackgroundColor="@color/sv_task_chip_background" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatSignage"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="SIGNAGE"
                    android:textColor="@color/sv_text"
                    app:chipBackgroundColor="@color/sv_task_chip_background" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatStock"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="STOCK"
                    android:textColor="@color/sv_text"
                    app:chipBackgroundColor="@color/sv_task_chip_background" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCatDisplay"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="DISPLAY"
                    android:textColor="@color/sv_text"
                    app:chipBackgroundColor="@color/sv_task_chip_background" />

            </com.google.android.material.chip.ChipGroup>

            <!-- Priority Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Priority"
                android:textColor="@color/sv_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupPriority"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:checkedChip="@id/chipPriMedium"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPriLow"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="LOW"
                    android:textColor="@color/sv_text"
                    app:chipBackgroundColor="@color/sv_task_chip_background" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPriMedium"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="MEDIUM"
                    android:textColor="@color/sv_text"
                    app:chipBackgroundColor="@color/sv_task_chip_background" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPriHigh"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="HIGH"
                    android:textColor="@color/sv_text"
                    app:chipBackgroundColor="@color/sv_task_chip_background" />

            </com.google.android.material.chip.ChipGroup>

            <!-- Error Banner -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/sv_error"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Please enter a non-blank task title." />

            <!-- Save Task Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveTask"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:text="Save Task"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/sv_accent"
                app:cornerRadius="10dp" />

            <ProgressBar
                android:id="@+id/pbSaving"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/sv_accent"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>