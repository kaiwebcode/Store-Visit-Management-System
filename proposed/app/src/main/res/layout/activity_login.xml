<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/sv_bg" android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="24dp"
        android:paddingEnd="24dp" android:paddingBottom="32dp">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="48dp" android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView android:layout_width="42dp" android:layout_height="42dp"
                android:src="@drawable/sv_brand_icon" android:contentDescription="StoreVisit logo" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:text="StoreVisit"
                android:textColor="@color/sv_text" android:textSize="25sp"
                android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:paddingStart="12dp"
                android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp"
                android:background="@drawable/sv_badge" android:text="FIELD OPS"
                android:textColor="@color/sv_accent" android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="54dp" android:text="Welcome back"
            android:textSize="33sp" android:textStyle="bold" android:textColor="@color/sv_text"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Sign in to manage assigned retail store visits and audit tasks."
            android:textSize="16sp" android:lineSpacingExtra="4dp"
            android:textColor="@color/sv_muted"/>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="32dp" android:hint="Username"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxBackgroundMode="outline" app:boxBackgroundColor="@color/sv_input_surface"
            app:boxStrokeColor="@color/sv_border" app:hintTextColor="@color/sv_muted"
            app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUsername" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="60dp"
                android:inputType="text" android:singleLine="true"
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:text="agent1" android:textColor="@color/sv_text"
                android:textColorHint="@color/sv_muted"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:hint="Password"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxBackgroundMode="outline" app:boxBackgroundColor="@color/sv_input_surface"
            app:boxStrokeColor="@color/sv_border" app:hintTextColor="@color/sv_muted"
            app:passwordToggleEnabled="true"
            app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="60dp"
                android:inputType="textPassword" android:singleLine="true"
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:text="password123" android:textColor="@color/sv_text" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/tvError" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:textColor="@color/sv_error" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin" android:layout_width="match_parent"
            android:layout_height="60dp" android:layout_marginTop="28dp"
            android:text="SIGN IN" android:textSize="17sp" android:textStyle="bold"
            android:textColor="@color/sv_text" app:backgroundTint="@color/sv_accent"
            app:cornerRadius="14dp"/>
        <ProgressBar android:id="@+id/pbLoading" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp" android:visibility="gone"/>
        <LinearLayout android:id="@+id/debugCredentialsContainer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="36dp"
            android:padding="18dp" android:background="@drawable/sv_card_background">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ⓘ  Test Credentials (Debug Only)"
                android:textSize="16sp" android:textStyle="bold" android:textColor="@color/sv_text"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textSize="13sp"
                android:textColor="@color/sv_muted"
                android:text="• agent1 / password123 (Alex Mercer)\n• agent2 / password123 (Sarah Connor)"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
